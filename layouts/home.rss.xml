{{- /*
  Home feed. Overrides Hugo's built-in RSS for three reasons:
    1. the default enumerates every regular page, so About / Archive / Search
       were showing up as feed items;
    2. it ships only .Description, throwing away the whole post;
    3. it used to carry the cover art as an <enclosure> and lead image; there
       is no cover art any more, so items are text only.
  Posts only, full content.
*/ -}}
{{- $pages := where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- $base := strings.TrimSuffix "/" site.BaseURL -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default site.Language.Lang }}</language>
    {{- with site.Params.author }}
    <managingEditor>{{ . }}</managingEditor>
    <webMaster>{{ . }}</webMaster>
    <copyright>© {{ site.Params.since }}–{{ now.Format "2006" }} {{ . }}</copyright>
    {{- end }}
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    {{- /* root-relative asset URLs are meaningless in a feed reader */}}
    {{- $body := .Content | replaceRE `(src|href)="(/[^/][^"]*)"` (printf `$1="%s$2"` $base) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- with site.Params.author }}<author>{{ . }}</author>{{ end }}
      {{- range .Params.tags }}
      <category>{{ . }}</category>
      {{- end }}
      <description>{{ .Description | default (.Summary | plainify) | chomp }}</description>
      <content:encoded><![CDATA[{{ $body }}]]></content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
